  --fasta_fn FASTA_FN   Fasta file with protein sequences. (default: None)
  --model_config MODEL_CONFIG
                        JSON file with model names. (default:
                        ./trained_models/model_config.json)
  -ont {mf,bp,cc,ec} [{mf,bp,cc,ec} ...], --ontology {mf,bp,cc,ec} [{mf,bp,cc,ec} ...]
